# Site URL & Canonical Base
NEXT_PUBLIC_SITE_URL=https://noirscents.netlify.app

# Project & Disclaimer Flags (Set to false for real store production)
NEXT_PUBLIC_SHOW_PROJECT_DISCLAIMER=false

# Social Media Links (leave empty if not configured)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Resend API credentials (from https://resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="Noir Scents <onboarding@resend.dev>"
MY_RECEIVING_EMAIL=noirscents01@gmail.com
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Admin Authentication Secret (Required for /api/inbox and /api/orders access)
ADMIN_SECRET=your_admin_secret_token_here

# Durable Server-Side Order Storage (Supabase PostgreSQL - https://supabase.com)
# Required for durable cross-device order persistence on Netlify serverless functions.
# Run lib/orders/schema.sql in Supabase SQL editor to create the orders table.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
